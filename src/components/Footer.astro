---
const currentLocale = Astro.currentLocale || 'ru';

const socials = [
  { name: 'Bandcamp', href: 'https://sektat.bandcamp.com', icon: 'bandcamp' },
  { name: 'Apple Music', href: 'https://music.apple.com/artist/sektat/1814322842', icon: 'apple' },
  { name: 'Instagram', href: 'https://instagram.com/sektat_band', icon: 'instagram' },
  { name: 'Telegram', href: 'https://t.me/sektat_band', icon: 'telegram' },
];

const labels = {
  ru: {
    copyright: '© 2025 SEKTAT. Все права защищены.',
    made: 'Москва',
  },
  en: {
    copyright: '© 2025 SEKTAT. All rights reserved.',
    made: 'Moscow',
  },
};

const t = labels[currentLocale as keyof typeof labels] || labels.ru;
---

<footer class="border-t border-sektat-gray bg-sektat-black mt-auto">
  <div class="container py-8 md:py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo & Copyright -->
      <div class="flex flex-col items-center md:items-start gap-2">
        <span class="text-2xl font-black tracking-tight">SEKTAT</span>
        <p class="text-sm text-sektat-light/60">{t.copyright}</p>
        <p class="text-xs text-sektat-light/40 font-mono">{t.made}</p>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-4">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-sektat-light/60 hover:text-sektat-rust-light transition-colors jitter-hover"
            aria-label={social.name}
          >
            {social.icon === 'bandcamp' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M0 18.75l7.437-13.5H24l-7.438 13.5H0z"/>
              </svg>
            )}
            {social.icon === 'apple' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/>
              </svg>
            )}
            {social.icon === 'instagram' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            )}
            {social.icon === 'telegram' && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
